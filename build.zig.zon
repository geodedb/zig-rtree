.{
    .name = .rtree,
    .version = "0.1.0",
    .fingerprint = 0xd34ac5721f5c8a90,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#1674ebbeb0eed7107e6e488cc9fd7b97a8036966",
            .hash = "thread_pool-0.2.1-11B1BqycdgAPt02YXm95pvBtazxHeJlzMBIUHZ0yTzSa",
        },
        // Optional otel observability backend. `lazy = true` means Zig
        // only fetches the package when build.zig actually reaches a
        // `b.lazyDependency("otel", ...)` call — which is itself gated
        // behind `-Dwith_otel=true`. Default builds therefore never
        // download or compile otel.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel#20078af231c069d88eaeb79dcf950b94366be624",
            .hash = "otel-0.1.0-B0v3lsl9MwCHrG8GDrxdFebugqjybfr4KAiplOJKCRG7",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
