.{
    .name = .rtree,
    .version = "0.1.15",
    .fingerprint = 0xd34ac5721f5c8a90,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.9#1d7275da020a43588c4f1885f7f725d5e8ce079e",
            .hash = "thread_pool-0.2.9-11B1Bqf7eQDfHhrQAkHk0e2ABigRBFNkFEAmc8t9raZe",
        },
        // Optional otel observability backend. `lazy = true` means Zig
        // only fetches the package when build.zig actually reaches a
        // `b.lazyDependency("otel", ...)` call — which is itself gated
        // behind `-Dwith_otel=true`. Default builds therefore never
        // download or compile otel.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.26#36b56fa3cce4161b8c3db60b16ca986234f0cfd5",
            .hash = "otel-0.1.26-B0v3ltusNQDirCpbgd4p9Pjotmhyr1lL54hcsVrYwKtj",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
        "benchmarks",
        "tests",
        "examples",
    },
}
