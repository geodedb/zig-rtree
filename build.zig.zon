.{
    .name = .rtree,
    .version = "0.1.3",
    .fingerprint = 0xd34ac5721f5c8a90,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#39528a3e92212efab8ed5840bc20e619a419c0f5",
            .hash = "thread_pool-0.2.4-11B1BnyUdgCUNlqgBwHNvE4plLwP1s1MAyCjODPafrpo",
        },
        // Optional otel observability backend. `lazy = true` means Zig
        // only fetches the package when build.zig actually reaches a
        // `b.lazyDependency("otel", ...)` call — which is itself gated
        // behind `-Dwith_otel=true`. Default builds therefore never
        // download or compile otel.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#64db4c05079b0f9493c6ecbe60ff3571266589d5",
            .hash = "otel-0.1.5-B0v3lvEMNAAIk-gM2fawa7UVOS3Whr1K460ZdcNgPeYn",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
