.{
    .name = .rtree,
    .version = "0.1.4",
    .fingerprint = 0xd34ac5721f5c8a90,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.6#aa4493781d962f42ba1dd37261e0e107be5f6ffe",
            .hash = "thread_pool-0.2.5-11B1BiNceQDdiX2mLCg-blCuvBT0ZHh0_A_gH9j7t2Gl",
        },
        // Optional otel observability backend. `lazy = true` means Zig
        // only fetches the package when build.zig actually reaches a
        // `b.lazyDependency("otel", ...)` call — which is itself gated
        // behind `-Dwith_otel=true`. Default builds therefore never
        // download or compile otel.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.13#31e4104d698c52758507e444edb1d770151239d6",
            .hash = "otel-0.1.9-B0v3ltPiNQD_qlCLj0oUor4puasXR8KWGfPpaE48icHy",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
