.{
    .name = .rtree,
    .version = "0.1.0",
    .fingerprint = 0xd34ac5721f5c8a90,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#c41388bdab88916bb453a20adae2c722405287d1",
            .hash = "thread_pool-0.2.1-11B1BsqSdgCqx_EsSPzdPqfGhNFzonijUGYfDuy0fpTb",
        },
        // Optional otel observability backend. `lazy = true` means Zig
        // only fetches the package when build.zig actually reaches a
        // `b.lazyDependency("otel", ...)` call — which is itself gated
        // behind `-Dwith_otel=true`. Default builds therefore never
        // download or compile otel.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#57ef1f221930e5fd85e50297588c253e04361733",
            .hash = "otel-0.1.0-B0v3lrgNNAA5vn53MsLSUUunxIAdI88cPgcgpgg5JMKr",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
